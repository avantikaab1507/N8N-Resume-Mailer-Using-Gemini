      "id": "70a89fe3-e0be-4212-8dc6-68026d664bfc",
      "name": "Aggregate Failures",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [896, 192]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst failures = [];\nfor (const i of items) { (i.json.failures || []).forEach(function (f) { failures.push(f); }); }\nconst parts = failures.map(function (f) {\n  return '<li><b>' + (f.company || '') + '</b> (' + (f.role || '') + ') - ' + (f.website || '') + ': ' + (f.reason || '') + '</li>';\n});\nconst html = '<p>The following ' + failures.length + ' companies could not be emailed:</p><ul>' + parts.join('') + '</ul>';\nreturn [{ json: { count: failures.length, summaryHtml: html } }];"
      },
      "id": "fac839ad-ba9a-47e8-a587-97411beddc18",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
