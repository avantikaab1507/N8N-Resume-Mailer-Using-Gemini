        "sendTo": "YOUR SECONDARY EMAIL ADDRESS",
        "subject": "=Application for {{ $(\"Extract Email\").item.json.role }} - {{ $(\"Run Config\").first().json.yourName }}",
        "message": "={{ $(\"Generate Cover Email\").item.json.candidates[0].content.parts[0].text }}",
        "options": {
