          ]
        },
        "options": {}
      },
      "id": "fb6afe6e-3c74-4a26-9ed7-e6e4704f5e37",
      "name": "Email Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [224, 96]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Write a concise, professional job application cover email in HTML (use only <p> paragraphs, no <html>/<body> wrapper, no subject line, no markdown).\nApplicant name: {{ $(\"Run Config\").first().json.yourName }}\nApplying for: {{ $json.role }} at {{ $json.company }}\nApplicant background to highlight: {{ $(\"Run Config\").first().json.background }}\n\nRequirements: address the hiring team politely, tailor 2-3 short paragraphs to the role and company, mention the attached resume, and end with a professional sign-off using the applicant name. Do not invent facts not supported by the background."
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {
          "maxOutputTokens": 1024,
          "temperature": 0.7
        }
      },
      "id": "d15ff1a6-ea1b-4531-a946-f9d5cf822fdc",
      "name": "Generate Cover Email",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [448, 0],
      "credentials": {
        "googleGeminiApi": {
          "id": "YOUR_CREDENTIALS_ID",
          "name": "YOUR CREDENTIALS NAME"
        }
      }
    },
    {
