{
  "name": "N8N Resume Mailer - Gemini - Email Not Found",
  "nodes": [
    {
      "parameters": {},
      "id": "9c0bd4dd-c83c-4beb-a1f0-64eeebe15b4f",
      "name": "When clicking Test workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "resumeUrl",
